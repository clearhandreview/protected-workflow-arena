{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/run-result.schema.json",
  "title": "Arena Public CLI Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "state"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "accepted",
        "running",
        "finished"
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "contained",
        "rejected",
        "timeout"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "finished"
          }
        }
      },
      "then": {
        "required": [
          "outcome"
        ]
      }
    }
  ]
}
