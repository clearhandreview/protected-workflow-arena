{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/run-ledger-entry.schema.json",
  "title": "Public Run Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "workload_type",
    "state",
    "request_digest"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workload_type": {
      "enum": [
        "ai",
        "kubernetes"
      ]
    },
    "state": {
      "enum": [
        "accepted",
        "running",
        "finished"
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "contained",
        "rejected",
        "timeout"
      ]
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
