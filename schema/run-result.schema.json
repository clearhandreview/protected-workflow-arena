{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/run-result.schema.json",
  "title": "Arena Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "state"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "accepted",
        "running",
        "finished"
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "contained",
        "rejected",
        "timeout"
      ]
    },
    "output_available": {
      "type": "boolean"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "finished"
          }
        }
      },
      "then": {
        "required": [
          "outcome",
          "output_available",
          "request_digest"
        ]
      }
    }
  ]
}
