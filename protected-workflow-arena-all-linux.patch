diff --git a/.github/workflows/validate.yml b/.github/workflows/validate.yml
index 27d3468..e15e987 100644
--- a/.github/workflows/validate.yml
+++ b/.github/workflows/validate.yml
@@ -19,3 +19,57 @@ jobs:
       - run: python -m unittest discover -s tests -v
       - run: python cli/arena.py validate --kind ai --file examples/ai-workflow.json
       - run: python cli/arena.py validate --kind kubernetes --file examples/kubernetes-job.yaml
+
+  linux-distributions:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - name: Ubuntu 24.04
+            image: ubuntu:24.04
+            install: apt-get update && apt-get install -y --no-install-recommends python3
+            python: python3
+          - name: Debian 12
+            image: debian:bookworm-slim
+            install: apt-get update && apt-get install -y --no-install-recommends python3
+            python: python3
+          - name: Debian 13
+            image: debian:trixie-slim
+            install: apt-get update && apt-get install -y --no-install-recommends python3
+            python: python3
+          - name: Fedora
+            image: fedora:latest
+            install: dnf install -y python3
+            python: python3
+          - name: Rocky Linux 9
+            image: rockylinux:9
+            install: dnf install -y python3.11
+            python: python3.11
+          - name: Rocky Linux 10
+            image: rockylinux:10
+            install: dnf install -y python3
+            python: python3
+          - name: Alpine 3.20
+            image: alpine:3.20
+            install: apk add --no-cache python3
+            python: python3
+          - name: Alpine 3.24
+            image: alpine:3.24
+            install: apk add --no-cache python3
+            python: python3
+          - name: openSUSE Tumbleweed
+            image: opensuse/tumbleweed:latest
+            install: zypper --non-interactive install python313
+            python: python3.13
+          - name: Arch Linux
+            image: archlinux:latest
+            install: pacman -Syu --noconfirm python
+            python: python
+    name: Linux / ${{ matrix.name }}
+    steps:
+      - uses: actions/checkout@v4
+      - name: Test on ${{ matrix.name }}
+        shell: bash
+        run: |
+          docker run --rm -e PYTHONDONTWRITEBYTECODE=1 -v "$GITHUB_WORKSPACE:/work" -w /work "${{ matrix.image }}" sh -lc '${{ matrix.install }} && ${{ matrix.python }} -c "import sys; assert sys.version_info >= (3, 11), sys.version" && ${{ matrix.python }} -m unittest discover -s tests -v && ${{ matrix.python }} cli/arena.py validate --kind ai --file examples/ai-workflow.json && ${{ matrix.python }} cli/arena.py validate --kind kubernetes --file examples/kubernetes-job.yaml'
